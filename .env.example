# --- Infrastructure ---------------------------------------------------------
# Postgres hosts three logical databases (one per service) on the same instance.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=wfm
POSTGRES_PASSWORD=wfm

ROSTERING_DATABASE_URL=postgres://wfm:wfm@127.0.0.1:5433/rostering
TIME_ATTENDANCE_DATABASE_URL=postgres://wfm:wfm@127.0.0.1:5433/time_attendance
STUDIO_DATABASE_URL=postgres://wfm:wfm@127.0.0.1:5433/studio

# Redis backs the execution queue (BullMQ) and the local event backbone
# (Redis Streams consumer groups). In production the backbone binding is
# Azure Event Hubs -- see docs/adr/0004-event-backbone.md.
REDIS_URL=redis://127.0.0.1:6380

# --- Service ports ----------------------------------------------------------
ROSTERING_PORT=4101
TIME_ATTENDANCE_PORT=4102
STUDIO_API_PORT=4103
STUDIO_WEB_PORT=4104

# Base URLs used by the studio API when calling domain services
ROSTERING_BASE_URL=http://127.0.0.1:4101
TIME_ATTENDANCE_BASE_URL=http://127.0.0.1:4102
STUDIO_API_BASE_URL=http://127.0.0.1:4103

# --- Event backbone ---------------------------------------------------------
EVENT_BACKBONE=redis          # redis | memory
EVENT_STREAM_PREFIX=wfm.events

# --- AI ---------------------------------------------------------------------
# Without a key the proposer node runs the deterministic rules engine, which is
# a supported operating mode (see docs/adr/0006-llm-optional.md).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
LLM_TIMEOUT_MS=20000

# --- Demo -------------------------------------------------------------------
DEMO_TENANT_ID=11111111-1111-4111-8111-111111111111
